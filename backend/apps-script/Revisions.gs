function getAuthorWorkflow(q){return jRead_(q,'AUTHOR',function(actor){var s=jManuscript_(q.manuscriptId);jOwner_(actor.id,s.manuscript_id);var decisions=jRows_('DECISIONS').filter(function(d){return d.manuscript_id===s.manuscript_id;}).map(function(d){return {type:d.type,message:d.message_to_author,feedback:jJson_(d.feedback_json,''),dueAt:d.revision_due_at,at:d.decided_at};});return {manuscriptId:s.manuscript_id,title:s.title_th,status:jCanonical_(s.status),version:Number(jMeta_(s).current_version),decisions:decisions,revisions:jRows_('REVISIONS').filter(function(r){return r.manuscript_id===s.manuscript_id;}).map(function(r){return {version:Number(r.version),at:r.submitted_at,responses:jJson_(r.responses_json,[])};}),files:jRows_('FILES').filter(function(f){return f.manuscript_id===s.manuscript_id&&f.visibility==='AUTHOR';}).map(function(f){return jFileView_(f,false);}),proofs:jRows_('AUTHOR_PROOFS').filter(function(p){return p.manuscript_id===s.manuscript_id;}).map(function(p){return {version:Number(p.version),result:p.result,message:p.message,at:p.confirmed_at};})};});}
function submitRevision(q){return jWrite_(q,'SUBMIT_REVISION','AUTHOR',function(actor,tx){var s=jManuscript_(q.manuscriptId);jOwner_(actor.id,s.manuscript_id);if(jCanonical_(s.status)!=='REVISION_REQUIRED')throw userError_('บทความยังไม่อยู่ในขั้นรอแก้ไข');var meta=jMeta_(s),responses=q.responses;if(!q.wordFile||!q.pdfFile||!Array.isArray(responses)||!responses.length||responses.length>100||responses.some(function(r){return !clean_(r.comment)||!clean_(r.response);}))throw userError_('กรุณาแนบ Word/PDF และตอบข้อเสนอแนะให้ครบ');tx.start();var version=Number(meta.current_version)+1;jSaveFile_(s,actor,q.wordFile,'REVISION_WORD',version,'AUTHOR');jSaveFile_(s,actor,q.pdfFile,'REVISION_PDF',version,'AUTHOR');var responseFile=q.responseFile?jSaveFile_(s,actor,q.responseFile,'RESPONSE_LETTER',version,'EDITOR'):'';jAppend_('REVISIONS',{revision_id:jUuid_(),manuscript_id:s.manuscript_id,version:version,submitted_by:actor.id,submitted_at:jNow_(),responses_json:JSON.stringify(responses.map(function(r){return {comment:clean_(r.comment,5000),response:clean_(r.response,5000),location:clean_(r.location,200),page:clean_(r.page,30),note:clean_(r.note,1000)};})),response_letter_file_id:responseFile});jUpsert_('WORKFLOW_META','manuscript_id',Object.assign(meta,{current_version:version,revised_at:jNow_(),proof_version:''}));jTransition_(s,'REVISED',actor,'ได้รับบทความฉบับแก้ไขแล้ว','');jAuthorMail_(s,'Revision Received','ได้รับฉบับแก้ไขแล้ว','revision-author:'+s.manuscript_id+':'+version);jEditorMail_(s,'Revision Received','มีบทความฉบับแก้ไข','revision-editor:'+s.manuscript_id+':'+version);return {version:version};});}
function submitAuthorProof(q){return jWrite_(q,'AUTHOR_PROOF','AUTHOR',function(actor,tx){var s=jManuscript_(q.manuscriptId);jOwner_(actor.id,s.manuscript_id);var meta=jMeta_(s);if(jCanonical_(s.status)!=='AUTHOR_PROOF'||Number(q.version)!==Number(meta.proof_version)||['CONFIRMED','CHANGES_REQUESTED'].indexOf(q.result)<0||q.result==='CHANGES_REQUESTED'&&!clean_(q.message))throw userError_('กรุณาตรวจเวอร์ชัน Proof และระบุรายละเอียดเมื่อขอแก้ไข');tx.start();jAppend_('AUTHOR_PROOFS',{proof_id:jUuid_(),manuscript_id:s.manuscript_id,version:meta.proof_version,result:q.result,message:clean_(q.message,5000),confirmed_by:actor.id,confirmed_at:jNow_()});var status=q.result==='CONFIRMED'?'READY_TO_PUBLISH':'LAYOUT';jTransition_(s,status,actor,q.result==='CONFIRMED'?'ผู้เขียนยืนยัน Proof แล้ว':'ผู้เขียนขอแก้ไข Proof','');jEditorMail_(s,'Author Proof',q.result,'author-proof:'+s.manuscript_id+':'+q.operationId);return {status:status};});}
function withdrawManuscript(q){return jWrite_(q,'WITHDRAW','EDITOR',function(actor,tx){var s=jManuscript_(q.manuscriptId);if(s.status==='PUBLISHED'||!clean_(q.reason))throw userError_('ต้องระบุเหตุผล และไม่สามารถถอนบทความที่เผยแพร่แล้วด้วยวิธีนี้');tx.start();jTransition_(s,'WITHDRAWN',actor,q.reason,q.internalNote);jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.manuscript_id===s.manuscript_id&&!a.cancelled_at&&a.review_status!=='Completed';}).forEach(function(a){jUpdate_('REVIEW_ASSIGNMENTS',a._row,{cancelled_at:jNow_()});});jAuthorMail_(s,'Withdrawn',q.reason,'withdraw:'+s.manuscript_id);return {withdrawn:true};});}
function jBeforeStatus_(s,status,q){if(properties_().getProperty('JOURNAL_READY')!=='true')return;var to=jCanonical_(status),from=jCanonical_(s.status),transitions={SUBMITTED:['DOCUMENT_CHECK'],DOCUMENT_CHECK:['SCREENING'],SCREENING:['REVIEWER_ASSIGNMENT'],REVIEWER_ASSIGNMENT:['SCREENING'],UNDER_REVIEW:['FINAL_REVIEW'],REVISED:['FINAL_REVIEW','REVIEWER_ASSIGNMENT'],ACCEPTED:['PROOFREADING'],PROOFREADING:['LAYOUT'],LAYOUT:[],AUTHOR_PROOF:[],READY_TO_PUBLISH:[],FINAL_REVIEW:['REVIEWER_ASSIGNMENT']};if(to===from)return;if((transitions[from]||[]).indexOf(to)<0)throw userError_('กรุณาใช้เมนูตัดสินบทความ ประเมิน Proof หรือเผยแพร่ เพื่อเปลี่ยนสถานะนี้');if(to==='FINAL_REVIEW'&&from==='UNDER_REVIEW'){var all=jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.manuscript_id===s.manuscript_id&&!a.cancelled_at&&a.invitation_status!=='Declined';}),round=all.reduce(function(n,a){return Math.max(n,Number(a.round));},0),current=all.filter(function(a){return Number(a.round)===round;});if(current.length<2||!current.every(function(a){return a.review_status==='Completed';}))throw userError_('ผลประเมินยังไม่ครบ');}if(to==='LAYOUT'&&!jProofComplete_(s))throw userError_('กรุณาตรวจ checklist ให้ครบก่อนจัดรูปแบบ');}
