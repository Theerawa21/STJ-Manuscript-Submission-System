var PROOF_KEYS_=['ภาษาไทย','ภาษาอังกฤษ','Abstract','Keywords','Reference','APA 7','Table','Figure','ชื่อผู้เขียน','Affiliation'];
function jProofComplete_(s){var meta=jMeta_(s),check=jRows_('PROOF_CHECKS').find(function(c){return c.manuscript_id===s.manuscript_id&&Number(c.version)===Number(meta.current_version);}),values=jJson_(check&&check.checks_json,[]);return values.length===10&&values.every(function(v){return v===true;});}
function getProductionDashboard(q){return jRead_(q,'PROOFREADER',function(actor){return {keys:PROOF_KEYS_,rows:rows_('SUBMISSIONS').filter(function(s){return (actor.role==='EDITOR'||jRows_('PRODUCTION_ASSIGNMENTS').some(function(a){return a.user_id===actor.id&&a.manuscript_id===s.manuscript_id;}))&&!!jMeta_(s).accepted_at&&['REJECTED','WITHDRAWN'].indexOf(s.status)<0;}).map(function(s){return {manuscriptId:s.manuscript_id,title:s.title_th,status:s.status,version:Number(jMeta_(s).current_version),check:jRows_('PROOF_CHECKS').find(function(c){return c.manuscript_id===s.manuscript_id&&Number(c.version)===Number(jMeta_(s).current_version);})||null};})};});}
function saveProofChecklist(q){return jWrite_(q,'PROOF_CHECKLIST','PROOFREADER',function(actor,tx){var s=jManuscript_(q.manuscriptId),meta=jMeta_(s);jProductionRight_(actor,s);if(!meta.accepted_at||['ACCEPTED','PROOFREADING','LAYOUT'].indexOf(jCanonical_(s.status))<0||Number(q.version)!==Number(meta.current_version))throw userError_('งานตรวจภาษาต้องเป็นบทความตอบรับและเวอร์ชันปัจจุบัน');if(!Array.isArray(q.checks)||q.checks.length!==10||q.checks.some(function(v){return typeof v!=='boolean';}))throw userError_('กรุณาตรวจ checklist ทั้ง 10 รายการ');tx.start();var record=jRows_('PROOF_CHECKS').find(function(c){return c.manuscript_id===s.manuscript_id&&Number(c.version)===Number(meta.current_version);}),data={manuscript_id:s.manuscript_id,version:meta.current_version,checks_json:JSON.stringify(q.checks),checked_by:actor.id,checked_at:jNow_(),note:clean_(q.note,5000)};if(record)jUpdate_('PROOF_CHECKS',record._row,data);else jAppend_('PROOF_CHECKS',data);if(s.status==='ACCEPTED')jTransition_(s,'PROOFREADING',actor,'อยู่ระหว่างตรวจภาษา','');return {saved:true,complete:jProofComplete_(s)};});}
function uploadLayout(q){return jWrite_(q,'UPLOAD_LAYOUT','EDITOR',function(actor,tx){var s=jManuscript_(q.manuscriptId),meta=jMeta_(s);jProductionRight_(actor,s);if(!meta.accepted_at||jCanonical_(s.status)!=='LAYOUT'||!jProofComplete_(s)||!q.pdfFile||!q.wordFile)throw userError_('ต้องผ่านตรวจภาษา อยู่ในขั้นจัดรูปแบบ และแนบ Final Word/PDF');tx.start();var proof=Number(meta.proof_version||meta.current_version)*1+1;jSaveFile_(s,actor,q.wordFile,'FINAL_WORD',proof,'AUTHOR');var fileId=jSaveFile_(s,actor,q.pdfFile,'FINAL_PDF',proof,'AUTHOR');jUpsert_('WORKFLOW_META','manuscript_id',Object.assign(meta,{proof_version:proof}));jTransition_(s,'AUTHOR_PROOF',actor,'กรุณาตรวจ Final PDF และยืนยันความถูกต้อง','');jAuthorMail_(s,'Author Proof Ready','Final PDF พร้อมตรวจ กรุณาเข้าสู่ระบบ','proof-ready:'+s.manuscript_id+':'+proof);return {proofVersion:proof,fileId:fileId};});}
function createAcceptanceLetter(q){return jWrite_(q,'ACCEPTANCE_LETTER','EDITOR',function(actor,tx){var s=jManuscript_(q.manuscriptId),meta=jMeta_(s);jProductionRight_(actor,s);if(!meta.accepted_at||!clean_(q.editorName)||!clean_(q.letterNumber))throw userError_('ต้องมีผลตอบรับ ชื่อบรรณาธิการ และเลขที่หนังสือ');var names=rows_('AUTHORS').filter(function(a){return a.manuscript_id===s.manuscript_id;}).map(function(a){return a.name_th;}).join(', '),logo=properties_().getProperty('JOURNAL_LOGO_FILE_ID'),logoHtml='';if(logo){var b=DriveApp.getFileById(logo).getBlob();logoHtml='<img width="80" src="data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes())+'">';}var html='<html><meta charset="utf-8"><style>body{font-family:Sarabun,Arial;font-size:16pt;padding:32px;line-height:1.6}</style>'+logoHtml+'<h2>วารสารวิชาการและนวัตกรรมเซนต์เทเรซา</h2><p>Saint Theresa Journal of Academic Studies and Innovation</p><h3>หนังสือตอบรับบทความ</h3><p>เลขที่ '+escapeHtml_(q.letterNumber)+'<br>วันที่ '+escapeHtml_(new Date().toLocaleDateString('th-TH'))+'</p><p>เรียน '+escapeHtml_(names)+'</p><p>กองบรรณาธิการได้ตอบรับบทความ “'+escapeHtml_(s.title_th)+'” รหัส '+escapeHtml_(s.manuscript_id)+' เพื่อเผยแพร่ในวารสาร โดยดำเนินการตรวจภาษา จัดรูปแบบ และตรวจ Proof ตามกระบวนการของวารสาร</p><p>'+escapeHtml_(q.editorName)+'<br>บรรณาธิการ</p></html>';tx.start();var pdf=Utilities.newBlob(html,'text/html','letter.html').getAs('application/pdf'),fileId=jSaveFile_(s,actor,{name:'Acceptance.pdf',base64:Utilities.base64Encode(pdf.getBytes())},'LETTER',meta.current_version,'AUTHOR');jAppend_('ACCEPTANCE_LETTERS',{letter_id:jUuid_(),manuscript_id:s.manuscript_id,letter_number:clean_(q.letterNumber,100),issued_at:jNow_(),file_id:fileId,editor_name:clean_(q.editorName,200)});jAuthorMail_(s,'Acceptance Letter','ดาวน์โหลดหนังสือตอบรับได้จากบทความของฉัน','letter:'+fileId);return {fileId:fileId};});}
