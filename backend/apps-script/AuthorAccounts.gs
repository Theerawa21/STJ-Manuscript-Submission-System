function ensureAccounts_(){var ss=spreadsheet_();[['USERS',['user_id','username','display_name','email','salt','password_hash','created_at']],['USER_SUBMISSIONS',['user_id','manuscript_id']]].forEach(function(spec){if(!ss.getSheetByName(spec[0])){var sh=ss.insertSheet(spec[0]);sh.appendRow(spec[1]);sh.setFrozenRows(1);}});}
function authorHash_(password,salt){var result=salt+password;for(var i=0;i<2000;i++)result=digest_(result);return result;}
function authorSession_(user){var token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('author:'+digest_(token),String(user.user_id),7200);return {token:token,displayName:String(user.display_name)};}
function requireAuthor_(token){var id=token&&CacheService.getScriptCache().get('author:'+digest_(String(token)));if(!id)throw userError_('กรุณาเข้าสู่ระบบผู้ส่งอีกครั้ง');return id;}
function registerAuthor(data){return response_(function(){ensureAccounts_();var username=clean_(data.username,60).toLowerCase(),email=normalizeEmail_(data.email),name=clean_(data.displayName,150),password=String(data.password||'');if(!/^[a-z0-9_.-]{4,40}$/.test(username))throw userError_('ชื่อผู้ใช้ต้องเป็นภาษาอังกฤษ ตัวเลข หรือ _ . - จำนวน 4–40 ตัว');if(!name||!/^\S+@\S+\.\S+$/.test(email)||password.length<10)throw userError_('กรุณากรอกชื่อ อีเมล และรหัสผ่านอย่างน้อย 10 ตัว');var lock=LockService.getScriptLock();lock.waitLock(30000);try{if(rows_('USERS').some(function(u){return u.username===username;}))throw userError_('ชื่อผู้ใช้นี้ถูกใช้แล้ว');var salt=Utilities.getUuid(),user={user_id:Utilities.getUuid(),username:username,display_name:name,email:email};sheet_('USERS').appendRow([user.user_id,username,safeCell_(name),safeCell_(email),salt,authorHash_(password,salt),new Date()]);return authorSession_(user);}finally{lock.releaseLock();}});}
function authorLogin(data){return response_(function(){ensureAccounts_();var username=clean_(data.username,60).toLowerCase(),cache=CacheService.getScriptCache(),key='author-fail:'+digest_(username),attempts=Number(cache.get(key)||0);if(attempts>=5)throw userError_('ลองเข้าสู่ระบบหลายครั้ง กรุณารอ 10 นาที');var u=rows_('USERS').find(function(x){return x.username===username;});if(!u||authorHash_(String(data.password||''),String(u.salt))!==String(u.password_hash)){cache.put(key,String(attempts+1),600);throw userError_('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');}cache.remove(key);return authorSession_(u);});}
function authorLogout(token){return response_(function(){if(token)CacheService.getScriptCache().remove('author:'+digest_(String(token)));return true;});}
function getMyManuscripts(data){return response_(function(){ensureAccounts_();var uid=requireAuthor_(data.token),ids=rows_('USER_SUBMISSIONS').filter(function(r){return r.user_id===uid;}).map(function(r){return r.manuscript_id;});return rows_('SUBMISSIONS').filter(function(s){return ids.indexOf(s.manuscript_id)>=0;}).map(function(s){return publicTrackingView_(s,rows_('STATUS_LOG').filter(function(l){return l.manuscript_id===s.manuscript_id;}));});});}
