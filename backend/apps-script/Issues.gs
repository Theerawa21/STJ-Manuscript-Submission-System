function listIssues(q){return jRead_(q,'EDITOR',function(){return {issues:jRows_('ISSUES'),articles:jRows_('ISSUE_ARTICLES'),ready:rows_('SUBMISSIONS').filter(function(s){return jCanonical_(s.status)==='READY_TO_PUBLISH';}).map(function(s){return {manuscriptId:s.manuscript_id,title:s.title_th};})};});}
function saveIssue(q){return jWrite_(q,'SAVE_ISSUE','EDITOR',function(actor,tx){var d=q.data||{},id=d.issue_id||jUuid_(),existing=jFind_('ISSUES','issue_id',id);if(existing&&existing.status==='Published')throw userError_('ไม่สามารถเปลี่ยนข้อมูลฉบับที่เผยแพร่แล้ว');if(!Number.isInteger(Number(d.volume))||Number(d.volume)<1||!Number.isInteger(Number(d.issue_number))||Number(d.issue_number)<1||!Number.isInteger(Number(d.year_be))||Number(d.year_be)<2500||!clean_(d.month)||!isFinite(new Date(d.publication_date).getTime()))throw userError_('กรุณากรอกข้อมูลฉบับและวันที่เผยแพร่ให้ถูกต้อง');if(jRows_('ISSUES').some(function(i){return i.issue_id!==id&&i.volume===String(d.volume)&&i.issue_number===String(d.issue_number);}))throw userError_('ปีที่และฉบับที่ซ้ำ');tx.start();var cover=d.cover_file_id||existing&&existing.cover_file_id||'';if(q.coverFile)cover=jSaveFile_(null,actor,q.coverFile,'COVER',1,'EDITOR');jUpsert_('ISSUES','issue_id',{issue_id:id,volume:Number(d.volume),issue_number:Number(d.issue_number),month:clean_(d.month,30),year_be:Number(d.year_be),year_ce:Number(d.year_be)-543,publication_date:d.publication_date,cover_file_id:cover,description:clean_(d.description,5000),status:d.status==='Preparing'?'Preparing':'Draft'});return {issueId:id};});}
function assignIssueArticle(q){return jWrite_(q,'ASSIGN_ISSUE_ARTICLE','EDITOR',function(actor,tx){var issue=jFind_('ISSUES','issue_id',q.issueId),s=jManuscript_(q.manuscriptId);if(!issue||issue.status==='Published'||jCanonical_(s.status)!=='READY_TO_PUBLISH')throw userError_('เลือกได้เฉพาะฉบับที่ยังไม่เผยแพร่และบทความพร้อมเผยแพร่');var start=Number(q.pageStart),end=Number(q.pageEnd),seq=Number(q.sequence);if(!Number.isInteger(start)||!Number.isInteger(end)||!Number.isInteger(seq)||start<1||end<start||seq<1)throw userError_('เลขหน้าและลำดับไม่ถูกต้อง');var rows=jRows_('ISSUE_ARTICLES');if(rows.some(function(a){return a.manuscript_id===s.manuscript_id&&a.issue_id!==q.issueId;}))throw userError_('บทความอยู่ในฉบับอื่นแล้ว');if(rows.some(function(a){return a.issue_id===q.issueId&&a.manuscript_id!==s.manuscript_id&&(Number(a.sequence)===seq||start<=Number(a.page_end)&&end>=Number(a.page_start));}))throw userError_('เลขหน้าหรือลำดับซ้ำกับบทความอื่น');tx.start();var existing=rows.find(function(a){return a.issue_id===q.issueId&&a.manuscript_id===s.manuscript_id;}),data={issue_id:q.issueId,manuscript_id:s.manuscript_id,sequence:seq,page_start:start,page_end:end};if(existing)jUpdate_('ISSUE_ARTICLES',existing._row,data);else jAppend_('ISSUE_ARTICLES',data);return {assigned:true};});}
function jPublicationCheck_(issue){if(!issue||issue.status==='Published')throw userError_('ฉบับนี้ไม่พร้อมเผยแพร่');if(new Date(issue.publication_date).getTime()>Date.now())throw userError_('ยังไม่ถึงวันที่กำหนดเผยแพร่');var articles=jRows_('ISSUE_ARTICLES').filter(function(a){return a.issue_id===issue.issue_id;});if(!articles.length)throw userError_('ไม่สามารถเผยแพร่ฉบับที่ไม่มีบทความ');return articles.map(function(a){var s=jManuscript_(a.manuscript_id),meta=jMeta_(s),decision=jRows_('DECISIONS').find(function(d){return d.manuscript_id===s.manuscript_id&&Number(d.version)===Number(meta.current_version)&&['ACCEPT','LEGACY_VERIFIED'].indexOf(d.type)>=0;}),confirmed=jRows_('AUTHOR_PROOFS').some(function(p){return p.manuscript_id===s.manuscript_id&&Number(p.version)===Number(meta.proof_version)&&p.result==='CONFIRMED';}),pdf=jRows_('FILES').find(function(f){return f.manuscript_id===s.manuscript_id&&Number(f.version)===Number(meta.proof_version)&&f.file_type==='FINAL_PDF';});if(jCanonical_(s.status)!=='READY_TO_PUBLISH'||!decision||!meta.accepted_at||!confirmed||!pdf||!s.abstract_th||!s.abstract_en||!s.keywords_th||!s.keywords_en)throw userError_('บทความ '+s.manuscript_id+' ยังไม่ครบเงื่อนไขการเผยแพร่');return {article:a,submission:s,meta:meta,pdf:pdf};});}
function validatePublication(q){return jRead_(q,'EDITOR',function(){return {valid:true,count:jPublicationCheck_(jFind_('ISSUES','issue_id',q.issueId)).length};});}
function publishIssue(q){return jWrite_(q,'PUBLISH_ISSUE','EDITOR',function(actor,tx){var issue=jFind_('ISSUES','issue_id',q.issueId),records=jPublicationCheck_(issue);tx.start();var now=jNow_();records.forEach(function(r){var s=r.submission,authors=rows_('AUTHORS').filter(function(a){return a.manuscript_id===s.manuscript_id;}).map(function(a){return {name:a.name_th,nameEn:a.name_en,affiliation:a.department};}),data={manuscriptId:s.manuscript_id,title:s.title_th,titleEn:s.title_en,type:s.article_type,authors:authors,abstract:s.abstract_th,abstractEn:s.abstract_en,keywords:s.keywords_th,keywordsEn:s.keywords_en,received:s.submitted_at,revised:r.meta.revised_at||'',accepted:r.meta.accepted_at,published:now,volume:Number(issue.volume),issue:Number(issue.issue_number),yearBE:Number(issue.year_be),pages:r.article.page_start+'–'+r.article.page_end,pdfFileId:r.pdf.file_id};jUpsert_('PUBLICATIONS','manuscript_id',{manuscript_id:s.manuscript_id,issue_id:issue.issue_id,public_json:JSON.stringify(data),pdf_file_id:r.pdf.file_id,published_at:now});});
    // Visibility switch occurs only after every public snapshot has been written.
    jUpdate_('ISSUES',issue._row,{status:'Published',published_at:now});if(issue.cover_file_id){var cover=jFind_('FILES','file_id',issue.cover_file_id);if(cover)jUpdate_('FILES',cover._row,{visibility:'PUBLIC'});}
    records.forEach(function(r){jUpdate_('FILES',r.pdf._row,{visibility:'PUBLIC'});jUpsert_('WORKFLOW_META','manuscript_id',Object.assign(r.meta,{issue_id:issue.issue_id}));jTransition_(r.submission,'PUBLISHED',actor,'เผยแพร่บทความแล้ว','');jAuthorMail_(r.submission,'Published','เผยแพร่ในปีที่ '+issue.volume+' ฉบับที่ '+issue.issue_number,'published:'+r.submission.manuscript_id);});return {published:true,count:records.length};});}
function getPublicJournal(q){return response_(function(){if(properties_().getProperty('JOURNAL_READY')!=='true')return {issues:[],articles:[],current:null};var issues=jRows_('ISSUES').filter(function(i){return i.status==='Published';}).sort(function(a,b){return new Date(b.publication_date)-new Date(a.publication_date);}).map(function(i){return {issueId:i.issue_id,volume:Number(i.volume),issue:Number(i.issue_number),month:i.month,yearBE:Number(i.year_be),date:i.publication_date,description:i.description,coverFileId:i.cover_file_id||''};}),id=q&&q.issueId||issues[0]&&issues[0].issueId,articles=jRows_('PUBLICATIONS').filter(function(p){return issues.some(function(i){return i.issueId===p.issue_id;})&&(q&&q.manuscriptId||!id||p.issue_id===id)&&(!q||!q.manuscriptId||p.manuscript_id===normalizeId_(q.manuscriptId));}).map(function(p){return jJson_(p.public_json,{});});articles.sort(function(a,b){return parseInt(a.pages,10)-parseInt(b.pages,10);});return {issues:issues,articles:articles,current:issues.find(function(i){return i.issueId===id;})||null};});}
