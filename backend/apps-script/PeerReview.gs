var REVIEW_CRITERIA_=['ความสำคัญและความน่าสนใจของเรื่อง','ความชัดเจนของชื่อเรื่อง','ความชัดเจนของวัตถุประสงค์','ความเหมาะสมของบทคัดย่อ','ความถูกต้องและความน่าเชื่อถือทางวิชาการ','แนวคิด ทฤษฎี และเอกสารที่เกี่ยวข้อง','ความเหมาะสมของวิธีดำเนินการ','ความชัดเจนของผลการศึกษา','ความสมเหตุสมผลของการอภิปรายผล','ความเหมาะสมของข้อสรุป','ความเหมาะสมของข้อเสนอแนะ','ความเหมาะสมของการอ้างอิง','ภาษาและการเรียบเรียง','คุณค่าหรือประโยชน์ของบทความ','ความเหมาะสมต่อการเผยแพร่'];
function listReviewers(q){return jRead_(q,'EDITOR',function(){return rows_('REVIEWERS').map(function(r){var profile=jFind_('REVIEWER_PROFILES','reviewer_id',r.reviewer_id)||{},jobs=jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.reviewer_id===r.reviewer_id&&!a.cancelled_at;});return Object.assign({},r,profile,{completed:jobs.filter(function(a){return a.review_status==='Completed';}).length,current:jobs.filter(function(a){return a.review_status!=='Completed'&&a.invitation_status!=='Declined';}).length,history:jobs});}).filter(function(r){var text=[r.name,r.organization,r.expertise].join(' ').toLowerCase();return (!q.query||text.indexOf(clean_(q.query).toLowerCase())>=0)&&(!q.expertise||String(r.expertise).toLowerCase().indexOf(clean_(q.expertise).toLowerCase())>=0);});});}
function saveReviewer(q){return jWrite_(q,'SAVE_REVIEWER','EDITOR',function(actor,tx){var d=q.data||{},name=clean_(d.name||[d.prefix,d.first_name,d.last_name].filter(Boolean).join(' '),200),email=normalizeEmail_(d.email);if(!name||!/^\S+@\S+\.\S+$/.test(email))throw userError_('กรุณากรอกชื่อและอีเมลให้ถูกต้อง');var id=d.reviewer_id||jUuid_(),existing=rows_('REVIEWERS').find(function(r){return r.reviewer_id===id;});if(rows_('REVIEWERS').some(function(r){return r.email===email&&r.reviewer_id!==id;}))throw userError_('อีเมลผู้ประเมินซ้ำ');if(d.reviewer_id&&!existing)throw userError_('ไม่พบผู้ประเมิน');tx.start();var row={reviewer_id:id,name:name,email:email,organization:clean_(d.organization,250),expertise:JSON.stringify(String(d.expertise||'').split(/[,\n]/).map(function(x){return clean_(x,100);}).filter(Boolean)),active:d.active!==false&&d.active!=='false'};if(existing)update_('REVIEWERS',existing._row,row);else append_('REVIEWERS',row);var profile={reviewer_id:id,updated_at:jNow_(),created_at:(jFind_('REVIEWER_PROFILES','reviewer_id',id)||{}).created_at||jNow_()};['prefix','first_name','last_name','name_en','position','qualification','subject_area','phone','notes'].forEach(function(k){profile[k]=clean_(d[k],1000);});jUpsert_('REVIEWER_PROFILES','reviewer_id',profile);return {reviewerId:id};});}
function jToken_(reviewer,assignment,purpose){var raw=jUuid_()+jUuid_();jAppend_('ACCESS_TOKENS',{token_hash:digest_(raw),reviewer_id:reviewer,assignment_id:assignment||'',purpose:purpose,expires_at:new Date(Date.now()+(purpose==='LOGIN'?30*60*1000:30*86400000)).toISOString()});return raw;}
function exchangeReviewerToken(q){return response_(function(){jReady_();var lock=LockService.getScriptLock();lock.waitLock(30000);try{var t=jFind_('ACCESS_TOKENS','token_hash',digest_(String(q.invitationToken||''))),r=t&&rows_('REVIEWERS').find(function(x){return x.reviewer_id===t.reviewer_id&&String(x.active)==='true';});if(!t||!r||t.used_at||t.revoked_at||new Date(t.expires_at).getTime()<Date.now())throw userError_('ลิงก์หมดอายุหรือถูกใช้งานแล้ว กรุณาขอลิงก์ใหม่');var a=t.assignment_id&&jFind_('REVIEW_ASSIGNMENTS','assignment_id',t.assignment_id);if(t.assignment_id&&(!a||a.cancelled_at||a.invitation_status==='Declined'))throw userError_('คำเชิญนี้ไม่สามารถใช้งานได้');jUpdate_('ACCESS_TOKENS',t._row,{used_at:jNow_()});var token=jUuid_()+jUuid_();CacheService.getScriptCache().put('reviewer:'+digest_(token),r.reviewer_id,7200);jAudit_({id:r.reviewer_id,role:'REVIEWER'},'LOGIN','','','สำเร็จ');return {token:token,name:r.name,assignmentId:t.assignment_id};}finally{lock.releaseLock();}});}
function requestReviewerLogin(q){return response_(function(){jReady_();var email=normalizeEmail_(q.email),cache=CacheService.getScriptCache(),key='reviewer-login:'+digest_(email);if(cache.get(key))return {message:'หากมีบัญชีที่ใช้งานอยู่ ระบบจะส่งลิงก์เข้าสู่ระบบให้ทางอีเมล'};cache.put(key,'1',600);var r=rows_('REVIEWERS').find(function(x){return x.email===email&&String(x.active)==='true';});if(r){var raw='{{TOKEN}}';jQueue_(r.email,'Reviewer Login','', 'เข้าสู่ระบบผู้ประเมิน','ลิงก์เข้าสู่ระบบ (มีอายุ 30 นาที): '+jPortal_()+'#invite='+raw,'login:'+jUuid_());}return {message:'หากมีบัญชีที่ใช้งานอยู่ ระบบจะส่งลิงก์เข้าสู่ระบบให้ทางอีเมล'};});}
function reviewerLogout(q){return response_(function(){if(q.token)CacheService.getScriptCache().remove('reviewer:'+digest_(q.token));return true;});}
function assignReviewers(q){return jWrite_(q,'ASSIGN_REVIEWERS','EDITOR',function(actor,tx){var s=jManuscript_(q.manuscriptId),meta=jMeta_(s),ids=q.reviewerIds||[],due=new Date(q.dueAt);if(!Array.isArray(ids)||ids.length<2||ids.length>10||new Set(ids).size!==ids.length)throw userError_('กรุณาเลือกผู้ประเมินอย่างน้อย 2 คน โดยไม่ซ้ำกัน');if(!isFinite(due.getTime())||due.getTime()<=Date.now())throw userError_('กรุณากำหนดวันครบกำหนดในอนาคต');if(['SCREENING','REVIEWER_ASSIGNMENT','REVISED','FINAL_REVIEW'].indexOf(jCanonical_(s.status))<0)throw userError_('สถานะบทความยังไม่พร้อมมอบหมาย');if(!q.blindChecked)throw userError_('กรุณาตรวจการปกปิดตัวผู้เขียนทั้งในเนื้อหาและ metadata ก่อน');var reviewers=ids.map(function(id){var r=rows_('REVIEWERS').find(function(x){return x.reviewer_id===id&&String(x.active)==='true';});if(!r)throw userError_('ผู้ประเมินต้องอยู่ในสถานะ Active');if(rows_('AUTHORS').some(function(a){return a.manuscript_id===s.manuscript_id&&normalizeEmail_(a.email)===r.email;}))throw userError_('ผู้เขียนไม่สามารถเป็นผู้ประเมินบทความของตนเอง');return r;});var old=jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.manuscript_id===s.manuscript_id&&!a.cancelled_at;});if(old.some(function(a){return Number(a.version)===Number(meta.current_version)&&a.review_status!=='Completed'&&a.invitation_status!=='Declined';}))throw userError_('ยังมีงานประเมินรอบปัจจุบัน กรุณายกเลิกก่อนมอบหมายรอบใหม่');tx.start();var round=old.reduce(function(n,a){return Math.max(n,Number(a.round)||0);},0)+1,fileId=jSaveFile_(s,actor,q.blindFile,'BLIND_PDF',meta.current_version,'REVIEWER');var result=[];reviewers.forEach(function(r){var id=jUuid_();jAppend_('REVIEW_ASSIGNMENTS',{assignment_id:id,manuscript_id:s.manuscript_id,reviewer_id:r.reviewer_id,round:round,version:meta.current_version,assigned_at:jNow_(),assigned_by:actor.id,due_at:due.toISOString(),invitation_status:'Pending',review_status:'Not Started',blind_file_id:fileId});var raw='{{TOKEN}}';jQueue_(r.email,'Reviewer Invitation',s.manuscript_id,'คำเชิญประเมินบทความ '+s.manuscript_id,'เรียน '+r.name+'\n'+s.title_th+'\nประเภท: '+s.article_type+'\nวันที่เชิญ: '+jNow_()+'\nครบกำหนด: '+due.toISOString()+'\nตอบรับหรือปฏิเสธ: '+jPortal_()+'#invite='+raw,'invite:'+id);result.push(id);});jTransition_(s,'REVIEWER_ASSIGNMENT',actor,'กำลังเชิญผู้ทรงคุณวุฒิ','');return {assignments:result,round:round,message:'บันทึกคำเชิญแล้ว ระบบจะส่งจากคิวอีเมล'};});}
function jAssignment_(actor,id){var a=jFind_('REVIEW_ASSIGNMENTS','assignment_id',id);if(!a||a.reviewer_id!==actor.id||a.cancelled_at)throw userError_('ไม่มีสิทธิ์เข้าถึงงานนี้');return a;}
function respondToInvitation(q){return jWrite_(q,'RESPOND_INVITATION','REVIEWER',function(actor,tx){var a=jAssignment_(actor,q.assignmentId);if(a.invitation_status!=='Pending')throw userError_('ได้ตอบคำเชิญนี้แล้ว');if(['Accepted','Declined'].indexOf(q.response)<0||q.response==='Declined'&&!clean_(q.reason))throw userError_('กรุณาเลือกคำตอบและระบุเหตุผลเมื่อปฏิเสธ');tx.start();jUpdate_('REVIEW_ASSIGNMENTS',a._row,{invitation_status:q.response,review_status:q.response==='Accepted'?'In Review':'Not Started',declined_reason:clean_(q.reason,2000)});var s=jManuscript_(a.manuscript_id),all=jRows_('REVIEW_ASSIGNMENTS').filter(function(r){return r.manuscript_id===s.manuscript_id&&Number(r.round)===Number(a.round)&&!r.cancelled_at;});if(all.filter(function(r){return r.invitation_status==='Accepted';}).length>=2&&jCanonical_(s.status)==='REVIEWER_ASSIGNMENT')jTransition_(s,'UNDER_REVIEW',actor,'อยู่ระหว่างการประเมิน','');jEditorMail_(s,'Reviewer '+q.response,'ผู้ประเมินตอบคำเชิญแล้ว','response:'+a.assignment_id);return {response:q.response};});}
function cancelAssignment(q){return jWrite_(q,'CANCEL_ASSIGNMENT','EDITOR',function(actor,tx){var a=jFind_('REVIEW_ASSIGNMENTS','assignment_id',q.assignmentId);if(!a||a.review_status==='Completed'||!clean_(q.reason))throw userError_('ยกเลิกได้เฉพาะงานที่ยังไม่ส่งผล และต้องระบุเหตุผล');tx.start();jUpdate_('REVIEW_ASSIGNMENTS',a._row,{cancelled_at:jNow_(),declined_reason:clean_(q.reason,2000)});return {cancelled:true};});}
function getReviewerDashboard(q){return jRead_(q,'REVIEWER',function(actor){return {criteria:REVIEW_CRITERIA_,tasks:jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.reviewer_id===actor.id&&!a.cancelled_at;}).map(function(a){var s=jManuscript_(a.manuscript_id);return {assignmentId:a.assignment_id,manuscriptId:s.manuscript_id,title:s.title_th,type:s.article_type,assignedAt:a.assigned_at,dueAt:a.due_at,invitationStatus:a.invitation_status,reviewStatus:a.review_status==='Completed'?'Completed':new Date(a.due_at).getTime()<Date.now()?'Overdue':a.review_status,round:Number(a.round)};})};});}
function getReviewerTask(q){return jRead_(q,'REVIEWER',function(actor){var a=jAssignment_(actor,q.assignmentId),s=jManuscript_(a.manuscript_id);if(a.invitation_status!=='Accepted')throw userError_('กรุณาตอบรับการประเมินก่อน');var f=jFind_('FILES','file_id',a.blind_file_id);return {assignmentId:a.assignment_id,manuscriptId:s.manuscript_id,title:s.title_th,titleEn:s.title_en,type:s.article_type,abstract:s.abstract_th,abstractEn:s.abstract_en,keywords:s.keywords_th,keywordsEn:s.keywords_en,file:jFileView_(f,true),criteria:REVIEW_CRITERIA_,completed:a.review_status==='Completed',draft:jJson_((jFind_('REVIEW_DRAFTS','assignment_id',a.assignment_id)||{}).draft_json,{}),result:jFind_('REVIEW_RESULTS','assignment_id',a.assignment_id)||null};});}
function saveReviewDraft(q){return jWrite_(q,'SAVE_REVIEW_DRAFT','REVIEWER',function(actor,tx){var a=jAssignment_(actor,q.assignmentId);if(a.invitation_status!=='Accepted'||a.review_status==='Completed')throw userError_('ไม่สามารถแก้ไขแบบประเมินนี้ได้');var json=JSON.stringify(q.data||{});if(json.length>50000)throw userError_('ข้อมูลมีความยาวเกินกำหนด');tx.start();jUpsert_('REVIEW_DRAFTS','assignment_id',{assignment_id:a.assignment_id,draft_json:json,updated_at:jNow_()});return {saved:true};});}
function submitReview(q){return jWrite_(q,'SUBMIT_REVIEW','REVIEWER',function(actor,tx){var a=jAssignment_(actor,q.assignmentId),d=q.data||{},scores=d.scores,s=jManuscript_(a.manuscript_id);if(a.invitation_status!=='Accepted'||a.review_status==='Completed')throw userError_('ไม่สามารถส่งหรือแก้ไขผลประเมินนี้ได้');if(jCanonical_(s.status)!=='UNDER_REVIEW')throw userError_('บทความยังไม่อยู่ในขั้นประเมิน');if(!Array.isArray(scores)||scores.length!==15||scores.some(function(n){return !Number.isInteger(Number(n))||Number(n)<1||Number(n)>5;}))throw userError_('กรุณาประเมินครบทั้ง 15 หัวข้อด้วยคะแนน 1–5');if(['ACCEPT','MINOR','MAJOR','REJECT'].indexOf(d.recommendation)<0||!clean_(d.suggestions))throw userError_('กรุณาเลือกผลสรุปและเขียนข้อเสนอแนะ');tx.start();var id=jUuid_(),now=jNow_();jAppend_('REVIEW_RESULTS',{review_id:id,assignment_id:a.assignment_id,scores_json:JSON.stringify(scores.map(Number)),strengths:clean_(d.strengths,10000),suggestions:clean_(d.suggestions,10000),comment_to_author:clean_(d.comment_to_author,10000),confidential_comment:clean_(d.confidential_comment,10000),recommendation:d.recommendation,submitted_at:now,locked_at:now});append_('REVIEWS',{review_id:id,manuscript_id:a.manuscript_id,reviewer_id:a.reviewer_id,status:'Completed',assigned_at:a.assigned_at,submitted_at:now,recommendation:d.recommendation});if(q.file)jSaveFile_(s,actor,q.file,'REVIEW_ATTACHMENT',a.version,'EDITOR',a.assignment_id);jUpdate_('REVIEW_ASSIGNMENTS',a._row,{review_status:'Completed',completed_at:now});var all=jRows_('REVIEW_ASSIGNMENTS').filter(function(r){return r.manuscript_id===a.manuscript_id&&Number(r.round)===Number(a.round)&&!r.cancelled_at&&r.invitation_status!=='Declined';});if(all.length>=2&&all.every(function(r){return r.review_status==='Completed';}))jEditorMail_(s,'Review Submitted','ผลประเมินครบแล้ว','reviews-complete:'+a.manuscript_id+':'+a.round);return {submitted:true,reviewId:id};});}
function getDecisionContext(q){return jRead_(q,'EDITOR',function(){var s=jManuscript_(q.manuscriptId),assign=jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.manuscript_id===s.manuscript_id;}),round=assign.reduce(function(n,a){return Math.max(n,Number(a.round));},0),current=assign.filter(function(a){return Number(a.round)===round&&!a.cancelled_at&&a.invitation_status!=='Declined';});return {submission:s,meta:jMeta_(s),assignments:assign.map(function(a){return Object.assign({},a,{reviewerName:(rows_('REVIEWERS').find(function(r){return r.reviewer_id===a.reviewer_id;})||{}).name,result:jFind_('REVIEW_RESULTS','assignment_id',a.assignment_id)||null});}),complete:current.length>=2&&current.every(function(a){return a.review_status==='Completed';}),progress:current.filter(function(a){return a.review_status==='Completed';}).length+'/'+Math.max(2,current.length),decisions:jRows_('DECISIONS').filter(function(d){return d.manuscript_id===s.manuscript_id;}),files:jRows_('FILES').filter(function(f){return f.manuscript_id===s.manuscript_id;}).map(function(f){return jFileView_(f,false);}),revisions:jRows_('REVISIONS').filter(function(r){return r.manuscript_id===s.manuscript_id;})};});}
function submitEditorialDecision(q){return jWrite_(q,'EDITORIAL_DECISION','EDITOR',function(actor,tx){var s=jManuscript_(q.manuscriptId),meta=jMeta_(s),assign=jRows_('REVIEW_ASSIGNMENTS').filter(function(a){return a.manuscript_id===s.manuscript_id&&!a.cancelled_at;});if(['UNDER_REVIEW','FINAL_REVIEW','REVISED','SCREENING','DOCUMENT_CHECK'].indexOf(jCanonical_(s.status))<0)throw userError_('สถานะบทความยังไม่พร้อมตัดสิน');if(['ACCEPT','MINOR','MAJOR','REJECT'].indexOf(q.decision)<0||!clean_(q.message))throw userError_('กรุณาเลือกผลตัดสินและข้อความถึงผู้เขียน');var round=assign.reduce(function(n,a){return Math.max(n,Number(a.round));},0),current=assign.filter(function(a){return Number(a.round)===round&&a.invitation_status!=='Declined';});if(q.decision!=='REJECT'&&!(jCanonical_(s.status)==='REVISED'&&jRows_('DECISIONS').some(function(d){return d.manuscript_id===s.manuscript_id&&['MINOR','MAJOR'].indexOf(d.type)>=0;}))&&(current.length<2||!current.every(function(a){return a.review_status==='Completed';})))throw userError_('ต้องได้รับผลประเมินครบอย่างน้อย 2 คนก่อนตัดสิน');if(['MINOR','MAJOR'].indexOf(q.decision)>=0&&(!clean_(q.feedback)||!q.feedbackChecked||new Date(q.revisionDueAt).getTime()<=Date.now()||!isFinite(new Date(q.revisionDueAt).getTime())))throw userError_('กรุณากำหนดวันแก้ไขและตรวจข้อเสนอแนะนิรนามก่อนแจ้งผู้เขียน');tx.start();jAppend_('DECISIONS',{decision_id:jUuid_(),manuscript_id:s.manuscript_id,version:meta.current_version,round:round,type:q.decision,message_to_author:clean_(q.message,10000),internal_note:clean_(q.internalNote,10000),decided_by:actor.id,decided_at:jNow_(),revision_due_at:q.revisionDueAt||'',feedback_json:JSON.stringify(clean_(q.feedback,30000))});var status=q.decision==='ACCEPT'?'ACCEPTED':q.decision==='REJECT'?'REJECTED':'REVISION_REQUIRED';if(status==='ACCEPTED')jUpsert_('WORKFLOW_META','manuscript_id',Object.assign(meta,{accepted_at:jNow_()}));jTransition_(s,status,actor,q.message,q.internalNote);jAuthorMail_(s,status==='ACCEPTED'?'Accepted':status==='REJECTED'?'Rejected':'Revision Required',q.message,'decision:'+s.manuscript_id+':'+meta.current_version+':'+q.operationId);return {status:status};});}
