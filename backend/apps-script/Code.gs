function doGet(e){if(properties_().getProperty('DATABASE_READY')!=='true'){setupSystem();properties_().setProperty('DATABASE_READY','true');}if(e&&e.parameter&&e.parameter.bridge==='1'){var page=HtmlService.createTemplateFromFile('Bridge');page.channel=/^[a-f0-9-]{36}$/.test(String(e.parameter.channel||''))?e.parameter.channel:'';return page.evaluate().setTitle('STJ Data Bridge').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}return HtmlService.createHtmlOutputFromFile('Index').setTitle('STJ Submission').addMetaTag('viewport','width=device-width, initial-scale=1');}
function response_(fn){try{return {ok:true,data:JSON.parse(JSON.stringify(fn()))};}catch(e){console.error(e&&e.stack?e.stack:e);return {ok:false,error:e&&e.publicMessage?e.publicMessage:'ระบบไม่สามารถดำเนินการได้ กรุณาลองใหม่หรือติดต่อกองบรรณาธิการ'};}}
function properties_(){return PropertiesService.getScriptProperties();}
function requiredProperty_(key){var value=properties_().getProperty(key);if(!value)throw new Error('ยังไม่ได้ตั้งค่า '+key);return value;}
function spreadsheet_(){return SpreadsheetApp.openById(requiredProperty_('SPREADSHEET_ID'));}
function sheet_(name){var sheet=spreadsheet_().getSheetByName(name);if(!sheet)throw new Error('ไม่พบชีต '+name);return sheet;}
function rows_(name){var values=sheet_(name).getDataRange().getValues();if(values.length<2)return[];var headers=values[0].map(String);return values.slice(1).filter(function(r){return r.some(function(v){return v!==''&&v!==null;});}).map(function(r,i){var o={_row:i+2};headers.forEach(function(h,j){o[h]=r[j];});return o;});}
